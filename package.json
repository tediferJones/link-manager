{
  "name": "link-manager",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "api",
    "app",
    "extension",
    "pwa"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:*",
    "dev:extension": "npm --workspace extension run dev",
    "dev:pwa": "npm --workspace pwa run dev",
    "dev:api": "npm --workspace api run dev",
    "test": "npm run test -ws --if-present",
    "typeCheck": "npm run typeCheck -ws --if-present"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "jsx-dom": "^8.1.6",
    "lucide": "^0.553.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.8",
    "vitest-chrome": "^0.1.0"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}
